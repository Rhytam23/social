# Premium PC E-Commerce Platform — Frontend Environment Variables
# Copy to .env and set your values

# ── App ──────────────────────────────────────────────────────────────────────
VITE_APP_TITLE="PREMIUM PC - Hardware & Custom Rigs"

# ── Backend API ───────────────────────────────────────────────────────────────
# Point this to the running server
VITE_API_URL=http://localhost:3001
VITE_API_TIMEOUT=10000

# ── Pagination ────────────────────────────────────────────────────────────────
VITE_DEFAULT_PAGE_SIZE=24
VITE_MAX_COMPARE_ITEMS=4

# ── Business ──────────────────────────────────────────────────────────────────
VITE_FREE_SHIPPING_THRESHOLD=500

# ── Feature Flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=false
