# Copy to .env.local and fill in. Never commit real values.
# Setup guide: docs/SETUP.md

# --- Supabase (required) ---------------------------------------------------
# Supabase dashboard -> Project Settings -> API. Copy the URL; don't retype it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SECRET. Bypasses row level security. Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Public address (production) ---------------------------------------------
# The site's public address, used for canonical links, sitemap.xml, robots.txt and link previews.
# On Vercel the project's production domain is used when this is empty.
# NEXT_PUBLIC_SITE_URL=https://chat.example.com

# --- Bot check on sign-in (optional) -----------------------------------------
# Cloudflare Turnstile site key (public). Also switch on CAPTCHA protection in Supabase
# (Authentication, Attack Protection) with the matching secret, or the check does nothing.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The address shown on the Contact page (defaults to the project owner's).
# NEXT_PUBLIC_CONTACT_EMAIL=

# --- Uploads -----------------------------------------------------------------
# Largest single file in MB. Must not exceed what your Supabase plan allows: the free plan caps a
# file at 50 MB (the default). After upgrading, set 100 to allow 100 MB videos.
# NEXT_PUBLIC_STORAGE_MAX_FILE_MB=50

# --- Calls (optional) -------------------------------------------------------
# Voice and video calls work between most home networks with the free public STUN
# server. For strict firewalls and mobile networks add a TURN relay. The relay only
# ever sees encrypted media. Server-side variables: do not prefix with NEXT_PUBLIC_.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# coturn "use-auth-secret" mode (credentials are minted per user, valid for one hour):
# TURN_SHARED_SECRET=long_random_secret
# ...or a fixed account from a hosted TURN provider:
# TURN_USERNAME=
# TURN_CREDENTIAL=
# STUN_URLS=stun:stun.l.google.com:19302

# --- Rate limiting (optional) ----------------------------------------------
# Shares API rate limits across several server instances. Without these,
# limits are kept in memory per instance.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
