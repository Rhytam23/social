# Café Server — Environment Variables

NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ── Security & CORS ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Email / Resend (Optional for contact message email delivery) ───────────
RESEND_API_KEY=
EMAIL_FROM="Café <onboarding@resend.dev>"
EMAIL_TO="contact@auracafe.dev"
