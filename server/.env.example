# Premium PC Server — Environment Variables
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Public base URL of THIS API server — used to build OAuth redirect URIs.
# REQUIRED in production (e.g. https://api.example.com). Defaults to http://localhost:PORT.
API_BASE_URL=http://localhost:3001

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Full connection string (preferred)
DATABASE_URL=postgresql://postgres:password@localhost:5432/premiumpc
# Optional direct (non-pooled) connection used by the migration runner.
# DATABASE_URL_DIRECT=postgresql://postgres:password@localhost:5432/premiumpc

# Or individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=premiumpc
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_before_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Frontend ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Session cookies MUST be SameSite=None;Secure when the SPA and API are on different
# domains (e.g. Vercel + Render). Set CROSS_SITE_COOKIES=true in that case.
# Leave as false or unset for local development (same-site, SameSite=Lax).
CROSS_SITE_COOKIES=false
# Production (Render): set CROSS_SITE_COOKIES=true

# ── Stripe (REQUIRED for payments — checkout returns 503 until configured) ───
# Use TEST keys (sk_test_...) in development; live keys only in production.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for the /api/payments/webhook endpoint.
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email / Resend (REQUIRED for OTP login and order confirmations) ──────────
# Without this, /api/auth/send-otp returns 503 in production.
# RESEND_API_KEY=re_...
# EMAIL_FROM="PREMIUM PC <orders@yourdomain.com>"

# ── Seeding ──────────────────────────────────────────────────────────────────
# Bootstrap admin password used by `npm run seed` (REQUIRED in production;
# a random one-time password is generated and printed in development).
# SEED_ADMIN_PASSWORD=

# ── OAuth ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=24
MAX_PAGE_SIZE=100

# ── Business Settings ────────────────────────────────────────────────────────
TAX_RATE=0.085
SHIPPING_RATE_STANDARD=0
SHIPPING_RATE_EXPRESS=19.99
FREE_SHIPPING_THRESHOLD=500
